# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. (.env는 git에 올리지 않습니다)

# LLM API 키: 셋 중 하나만 채우면 됩니다.
# 모두 비워 두면 LLM 답변 없이 검색된 발췌문만 보여 줍니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# (선택) 키를 여러 개 넣었을 때 쓸 회사: anthropic / openai / gemini
LLM_PROVIDER=

# (선택) 모델 이름. 비워 두면 llm.py의 기본 모델을 씁니다.
LLM_MODEL=

# (선택) DNV 규정 PDF가 있는 폴더. 비워 두면 이 폴더와 같은 위치에 있는 DNV 폴더를 씁니다.
DOCS_DIR=
