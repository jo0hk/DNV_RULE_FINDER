# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. (.env는 git에 올리지 않습니다)

# LLM API 키: 셋 중 하나만 채우면 됩니다.
# 모두 비워 두면 LLM 답변 없이 검색된 발췌문만 보여 줍니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# (선택) 키를 여러 개 넣었을 때 쓸 회사: anthropic / openai / gemini
LLM_PROVIDER=

# (선택) 모델 이름. 비워 두면 llm.py의 기본 모델을 씁니다.
LLM_MODEL=

# (선택) DNV 규정 PDF가 있는 폴더. 비워 두면 이 폴더와 같은 위치에 있는 DNV 폴더를 씁니다.
DOCS_DIR=

# ---- 아래 둘은 서버를 인터넷에 공개할 때만 씁니다. 로컬에서는 비워 둡니다. ----
# 화면을 다른 주소(GitHub Pages)에 올렸을 때 그 주소. 예: https://jo0hk.github.io
ALLOWED_ORIGINS=
# LLM 답변 하루 상한 (API 요금 보호). 비워 두면 제한 없음
ANSWER_LIMIT_PER_DAY=
